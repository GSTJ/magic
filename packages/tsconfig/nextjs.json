{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "magic-tsconfig/nextjs",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "exclude": ["node_modules", "build", "dist", ".next", ".expo", "out"]
}
