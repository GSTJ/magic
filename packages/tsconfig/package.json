{
  "name": "magic-tsconfig",
  "version": "1.0.0",
  "description": "Shared TypeScript config bases for GSTJ projects (base, internal-package, nextjs, expo).",
  "keywords": [
    "config",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/GSTJ/magic/tree/main/packages/tsconfig#readme",
  "bugs": {
    "url": "https://github.com/GSTJ/magic/issues"
  },
  "license": "MIT",
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/magic.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "*.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "echo \"magic-tsconfig ships JSON only\""
  }
