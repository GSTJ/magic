{
  "name": "magic-oxlint-plugin",
  "version": "1.2.2",
  "description": "oxlint JS-plugin rules for GSTJ projects. Opt-in under `magic/*`: prefer-early-return, no-ancestor-directory-import, no-barrel-file, no-manual-classname, no-module-mocks, prefer-suspense-query, react-hooks-strict-return, react-require-autocomplete. Plus `react-native/*` — no-inline-styles, no-color-literals, no-single-element-style-arrays, no-unused-styles — ported from eslint-plugin-react-native and wired by magic-oxlint-config.",
  "keywords": [
    "eslint-plugin",
    "lint",
    "oxc",
    "oxlint",
    "plugin"
  ],
  "homepage": "https://github.com/GSTJ/magic/tree/main/packages/oxlint-plugin#readme",
  "bugs": {
    "url": "https://github.com/GSTJ/magic/issues"
  },
  "license": "MIT",
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/magic.git",
    "directory": "packages/oxlint-plugin"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "clean": "rm -rf dist .turbo",
    "lint": "oxlint",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "magic-tsconfig": "workspace:*",
    "oxlint": "1.75.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.75.0"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
