{
  "name": "@magic/root",
  "version": "0.0.0",
  "private": true,
  "description": "GSTJ's shared tooling monorepo: lint, format, TypeScript, docs, observability, reusable GitHub workflows, and Renovate.",
  "homepage": "https://github.com/GSTJ/magic#readme",
  "bugs": {
    "url": "https://github.com/GSTJ/magic/issues"
  },
  "license": "MIT",
  "author": "Gabriel Taveira <gabrielstaveira@gmail.com> (https://github.com/GSTJ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/magic.git"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "oxlint --disable-nested-config --report-unused-disable-directives",
    "lint:fix": "oxlint --disable-nested-config --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "turbo run typecheck && pnpm run typecheck:registry",
    "typecheck:registry": "tsc -p registry/tsconfig.json",
    "test": "turbo run test",
    "check": "pnpm run build && pnpm run validate-rules && pnpm run validate-observability && pnpm run validate-workflows && pnpm run validate-registry && pnpm run validate-renovate && pnpm run validate-readmes && pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run test:scripts && pnpm run smoke && pnpm run adversarial",
    "smoke": "node scripts/smoke.mjs",
    "adversarial": "node fixtures/adversarial/run.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "validate-observability": "node scripts/validate-observability.mjs",
    "validate-readmes": "node scripts/validate-readmes.mjs",
    "validate-registry": "node scripts/validate-registry.mjs",
    "validate-renovate": "node scripts/validate-renovate.mjs",
    "validate-rules": "node scripts/validate-rules.mjs",
    "validate-workflows": "node scripts/validate-workflows.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "gsap": "3.15.0",
    "magic-oxfmt-config": "workspace:*",
    "magic-oxlint-config": "workspace:*",
    "magic-oxlint-plugin": "workspace:*",
    "magic-tsconfig": "workspace:*",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
